# Скопируйте в .env и заполните. Файл .env не попадает в git.
# Если переменная не задана, действует значение по умолчанию из src/config.py.
# Логические значения: 1/true/yes/on.

# === Telegram ===
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Id чатов через запятую, которым можно пользоваться ботом. Пусто — доступ закрыт всем.
TELEGRAM_ALLOWED_CHAT_IDS=
# Необязательно: чат разработчика для коротких уведомлений о проблемах.
SUPPORT_CHAT_ID=

# === Движок (агент) ===
# Ключ DeepSeek API.
DEEPSEEK_API_KEY=
ENGINE_BACKEND=codex
ENGINE_TURN_TIMEOUT_S=180
ENGINE_RETRIES=1
CODEX_COMMAND=codex
CODEX_MODEL=deepseek-v4-flash
CODEX_REASONING_EFFORT=medium

# === Хранилища ===
# google — настоящая таблица, fixture — тестовая таблица в памяти.
SHEETS_BACKEND=fixture
# Путь к JSON-ключу сервисного аккаунта Google.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Id таблицы: одна вкладка на объект.
GOOGLE_SHEET_ID=
SHEET_FIXTURE_FILE=tests/fixtures/sample_grid.json
# Вкладки-объекты для fixture, через запятую.
FIXTURE_SITES=Садик,Школа
# bitrix — настоящий Битрикс24, fake — приёмник в памяти.
CRM_BACKEND=fake
# Адрес входящего вебхука Битрикс24 (секрет).
BITRIX_WEBHOOK_URL=
BITRIX_FIELDS_FILE=data/bitrix_fields.json

# === Работа бота ===
CA_TZ=Europe/Moscow
CA_DATA_DIR=data
# Бот задаёт сам для каждого хода. Оставьте пустым.
CA_CHAT_DIR=
FRICTION_LOG=logs/friction.jsonl
HISTORY_TURNS=6
SNAPSHOT_MAX_AGE_S=60
CARD_PAGE_SIZE=8
LOG_LEVEL=INFO

# === MCP-сервер ===
# Предел вызовов инструментов за один ход (защита от зацикливания).
MCP_MAX_TOOL_CALLS_PER_RUN=100
ENABLE_RUN_TELEMETRY=true
RUN_TELEMETRY_LOG=logs/run_telemetry.jsonl
